# Network Orchestrator — environment template.
#
# Copy to `.env` and fill in locally:  cp .env.example .env
# NEVER commit `.env`. It is gitignored, and CI runs a secret scan.
#
# Values shown below are non-sensitive defaults/placeholders only.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (Postgres 16)
# ---------------------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# With docker compose the host is `db`. The password is a local dev placeholder.
DATABASE_URL=postgres://orchestrator:orchestrator@localhost:5432/orchestrator?sslmode=disable
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator

# ---------------------------------------------------------------------------
# UniFi credentials — RUNTIME SECRETS, inject out-of-band. Leave blank here.
# ---------------------------------------------------------------------------
# The adapter stays disabled until you opt in. With UNIFI_ENABLED=false the API
# boots with no UniFi credentials (this is what CI and the smoke test use).
UNIFI_ENABLED=false

# cloud | local
#   cloud -> UniFi Site Manager API (read-only, reachable from anywhere)
#   local -> console Integration API (write-capable; office LAN/VPN only)
UNIFI_MODE=cloud

# Site Manager cloud API key (READ scope). Required when
# UNIFI_MODE=cloud and UNIFI_ENABLED=true.
UNIFI_SM_API_KEY=

# Console Integration API (LAN/VPN only). Required when UNIFI_MODE=local.
UNIFI_LOCAL_URL=
UNIFI_LOCAL_API_KEY=

# Optional: only needed on the Connector Proxy path.
UNIFI_CONSOLE_ID=

# Optional: path to a PEM file holding the controller CA, so self-signed
# controllers can be verified properly. Never disable TLS verification.
# UNIFI_CA_FILE=/etc/network-orchestrator/unifi-ca.pem

# ---------------------------------------------------------------------------
# Sync / cache freshness
# ---------------------------------------------------------------------------
# Server-side poll interval. Must be smaller than SYNC_STALE_AFTER.
SYNC_INTERVAL=60s
# Readiness goes 503 when the last successful sync is older than this.
SYNC_STALE_AFTER=180s

# ---------------------------------------------------------------------------
# Client event retention (ADR-005)
# ---------------------------------------------------------------------------
# How much client connect/disconnect history `client_events` keeps. Rows older
# than this are deleted by a scheduled job inside the API — our own database,
# never the UniFi network. Both values are Go durations.
CLIENT_EVENTS_RETENTION=720h
# How often that job runs. Keeps the overshoot above the window small.
CLIENT_EVENTS_PRUNE_INTERVAL=1h

# ---------------------------------------------------------------------------
# Operator auth
# ---------------------------------------------------------------------------
# Used ONCE to seed the first admin on an empty database, then rotate/remove.
ADMIN_BOOTSTRAP_PASSWORD=
